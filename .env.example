# Server-side settings for functions/api/book.ts.
# Set these in Cloudflare Pages -> Settings -> Environment variables (Production and Preview).
# For local testing with `wrangler pages dev`, put them in a .dev.vars file (git-ignored).

# Slack or Discord incoming-webhook URL for instant new-booking alerts.
LEAD_WEBHOOK_URL=""

# Resend API key and a sender on a domain verified in Resend, e.g. "Zyvibe <hello@zyvibe.com>".
RESEND_API_KEY=""
EMAIL_FROM=""

# Optional: also email each new booking to this inbox.
NOTIFY_EMAIL=""
