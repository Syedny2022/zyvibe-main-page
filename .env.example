# Names only. Set real values in Cloudflare Pages → Settings → Environment variables.

# Build-time (public) — Cloudflare Turnstile site key for the /start form.
VITE_TURNSTILE_SITE_KEY=

# Runtime secrets for Pages Functions.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
# Optional: maximum concepts generated per 24 hours (defaults to 40).
DAILY_CONCEPT_LIMIT=
