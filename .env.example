# Server-side settings for functions/api/book.ts.
# Set these in Cloudflare Pages -> Settings -> Environment variables (Production and Preview).
# For local testing with `wrangler pages dev`, put them in a .dev.vars file (git-ignored).

# Instant new-booking alerts: a Slack (or Discord) incoming-webhook URL, and/or a Telegram bot.
LEAD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Resend API key and a sender on a domain verified in Resend, e.g. "Zyvibe <studio@mail.zyvibe.com>" (subdomain only, never the root domain).
RESEND_API_KEY=""
# Optional; defaults to "Zyvibe <studio@mail.zyvibe.com>".
EMAIL_FROM=""

# Optional: inbox that receives a copy of each booking and replies to confirmations.
NOTIFY_EMAIL=""
