{
  "name": "zyvibe-main-page",
  "private": true,
  "version": "1.0.0",
  "description": "zyvibe.com: the Zyvibe Website Sprint site (static HTML + Cloudflare Pages Functions).",
  "author": "Zyvibe",
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs && tailwindcss -i assets/css/input.css -o dist/assets/css/site.css --minify",
    "dev": "npm run build && npx wrangler@3 pages dev dist",
    "typecheck": "tsc --noEmit -p functions",
    "lint": "npm run typecheck"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3"
  }
}
